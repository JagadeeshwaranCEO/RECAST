# RECAST works fully without an AI provider key. Set this to the production
# Vercel URL after the first deployment so metadata and share links are canonical.
NEXT_PUBLIC_SITE_URL=https://recast-campaign-studio.vercel.app

# Supabase (added after creating the dedicated RECAST project).
# Only the URL and publishable key belong in the browser. Never expose a service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional organizer-listed AI provider fabric. Configure any one key; secrets
# stay server-side. RECAST_AI_PROVIDER can be auto, openrouter, gemini, groq,
# nvidia, or openai. Auto selects the first configured provider in that order.
RECAST_AI_PROVIDER=auto

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b

# Existing OpenAI adapter remains supported as an optional fifth provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
